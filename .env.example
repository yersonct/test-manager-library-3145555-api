APP_NAME="Manager Library API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=library
DB_USERNAME=library
DB_PASSWORD=replace-before-starting

JWT_SECRET=replace-with-a-long-random-secret
JWT_TTL=28800
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-before-starting
CORS_ORIGIN=http://localhost:5173
